                    "title": "Chart only this metric",
                    "url": "/d/metrics?${__url_time_range}&${type:queryparam}&${category:queryparam}&${kind:queryparam}&${show:queryparam}&${search:queryparam}&var-metric=${__data.fields.metric_id}"
                  },
                  {
                    "title": "Add to the chart",
                    "url": "/d/metrics?${__url_time_range}&${__all_variables}&var-metric=${__data.fields.metric_id}"
                  }
                ]
              }
            ]
