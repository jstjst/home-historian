      },
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "timescaledb"
        },
        "query": "SELECT met.type::text || ' / ' || met.display_name || coalesce(' ' || met.display_subname, '')\n       || CASE WHEN met.display_name <> met.native_key THEN ' [' || met.native_key || ']' ELSE '' END AS __text,\n       met.metric_id AS __value\nFROM metrics met\nLEFT JOIN metric_notes n USING (metric_id)\nWHERE met.type::text IN (${type:singlequote})\n  AND coalesce(met.category::text, 'none') IN (${category:singlequote})\n  AND coalesce(met.kind::text, 'none') IN (${kind:singlequote})\n  AND CASE '$show' WHEN 'stubs' THEN met.display_name = met.native_key\n                   WHEN 'named' THEN met.display_name <> met.native_key\n                   WHEN 'noted' THEN n.note IS NOT NULL\n                   ELSE true END\n  AND concat_ws(' ', met.native_key, met.display_name, met.display_subname, n.note) ILIKE '%$search%'\nORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Metrics",
      "description": "One row per metric, with its latest value in the selected time range (one row per device where several devices of the type report it; empty where none did). kind: measured (sensor, meter), setting (configured), state (determined by the device), empty until set. The filters above narrow the list: Show = stubs (display_name = native_key), named, or noted (has a note); Search looks in native_key, display name, display subname and note. Click a native_key to chart that metric or to add it to the chart.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT met.metric_id,\n       met.type::text AS type,\n       met.native_key,\n       met.display_name,\n       met.display_subname,\n       seen.latest_value,\n       n.note,\n       met.unit,\n       met.category::text AS category,\n       met.kind::text AS kind,\n       seen.device,\n       seen.latest,\n       met.value_type::text AS value_type,\n       met.disabled\nFROM metrics met\nLEFT JOIN metric_notes n USING (metric_id)\nLEFT JOIN LATERAL (\n  -- the latest value in the time range, per device that reported one\n  SELECT d.name AS device, l.time AS latest, l.value AS latest_value\n  FROM devices d\n  CROSS JOIN LATERAL (\n    SELECT m.time, coalesce(m.value_str, m.value_num::text, m.value_bool::text) AS value\n    FROM measurements m\n    WHERE m.device_id = d.device_id\n      AND m.metric_id = met.metric_id\n      AND $__timeFilter(m.time)\n    ORDER BY m.time DESC\n    LIMIT 1\n  ) l\n  WHERE d.type = met.type\n) seen ON true\nWHERE met.type::text IN (${type:singlequote})\n  AND coalesce(met.category::text, 'none') IN (${category:singlequote})\n  AND coalesce(met.kind::text, 'none') IN (${kind:singlequote})\n  AND CASE '$show' WHEN 'stubs' THEN met.display_name = met.native_key\n                   WHEN 'named' THEN met.display_name <> met.native_key\n                   WHEN 'noted' THEN n.note IS NOT NULL\n                   ELSE true END\n  AND concat_ws(' ', met.native_key, met.display_name, met.display_subname, n.note) ILIKE '%$search%'\nORDER BY met.type, met.native_key, seen.device"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "native_key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
