          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT coalesce(category::text, 'none') FROM metrics ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
