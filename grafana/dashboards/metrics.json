    {
      "id": 2,
      "type": "timeseries",
      "title": "Values over time",
      "description": "The metrics selected in Metric, one axis per unit. Booleans are drawn as 0/1; text values only where they parse as a number (a stub stores everything as text). The number in brackets is the metric_id.",
      "gridPos": {
        "h": 12,
        "w": 15,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(m.time, $__interval) AS \"time\",\n       d.name || ' / ' || met.display_name || coalesce(' ' || met.display_subname, '') || ' [' || met.metric_id || ']' AS metric,\n       coalesce(met.unit, '') AS unit,\n       avg(coalesce(m.value_num, m.value_bool::int, m.value_str::double precision)) AS value\nFROM measurements m\nJOIN devices d USING (device_id)\nJOIN metrics met USING (metric_id)\nWHERE $__timeFilter(m.time)\n  AND m.metric_id = ANY ('{${metric:csv}}')\n  AND (m.value_str IS NULL OR pg_input_is_valid(m.value_str, 'double precision'))\nGROUP BY 1, 2, 3\nORDER BY 1"
        }
      ],
      "fieldConfig": {
