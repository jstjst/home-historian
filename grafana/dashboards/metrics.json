      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "timescaledb"
        },
        "query": "SELECT 'none'\nUNION ALL\nSELECT k::text FROM unnest(enum_range(NULL::metric_kind)) AS k",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
