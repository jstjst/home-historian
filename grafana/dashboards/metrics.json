        "query": "all,stubs,named,noted",
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "stubs",
            "value": "stubs",
            "selected": false
          },
          {
            "text": "named",
            "value": "named",
            "selected": false
          },
          {
            "text": "noted",
            "value": "noted",
            "selected": false
