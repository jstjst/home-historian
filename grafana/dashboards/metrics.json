        "update": {
          "method": "datasource",
          "datasource": "timescaledb",
          "payloadMode": "custom",
          "getPayload": "const value = (id) => context.panel.elements.find((e) => e.id === id).value;\n\n// base64 of the UTF-8 bytes; the query decodes it\nconst encode = (text) => {\n  let binary = '';\n  new TextEncoder().encode(String(text ?? '').trim()).forEach((b) => {\n    binary += String.fromCharCode(b);\n  });\n  return btoa(binary);\n};\n\nreturn {\n  display_name: encode(value('display_name')),\n  display_subname: encode(value('display_subname')),\n  unit: encode(value('unit')),\n  category: encode(value('category')),\n  kind: encode(value('kind')),\n  disabled: value('disabled') === true ? 'true' : 'false',\n  // the plugin keeps line breaks in a textarea as the two characters \\n\n  note: encode(String(value('note') || '').replaceAll('\\\\n', '\\n')),\n};",
          "payload": {
            "refId": "A",
            "datasource": {
              "type": "postgres",
              "uid": "timescaledb"
            },
            "format": "table",
            "rawQuery": true,
            "editorMode": "code",
            "rawSql": "WITH new AS (\n  SELECT metric_id,\n         convert_from(decode('${payload.display_name}', 'base64'), 'UTF8') AS display_name,\n         convert_from(decode('${payload.display_subname}', 'base64'), 'UTF8') AS display_subname,\n         convert_from(decode('${payload.unit}', 'base64'), 'UTF8') AS unit,\n         convert_from(decode('${payload.category}', 'base64'), 'UTF8') AS category,\n         convert_from(decode('${payload.kind}', 'base64'), 'UTF8') AS kind,\n         '${payload.disabled}'::boolean AS disabled,\n         convert_from(decode('${payload.note}', 'base64'), 'UTF8') AS note\n  FROM metrics\n  WHERE metric_id = ANY ('{${metric:csv}}')\n    -- one form edits one metric\n    AND cardinality('{${metric:csv}}'::int[]) = 1\n),\ndefined AS (\n  UPDATE metrics met\n  SET display_name    = new.display_name,\n      display_subname = nullif(new.display_subname, ''),\n      unit            = nullif(new.unit, ''),\n      category        = nullif(new.category, 'none')::category,\n      kind            = nullif(new.kind, 'none')::metric_kind,\n      disabled        = new.disabled\n  FROM new\n  WHERE met.metric_id = new.metric_id\n    -- a form that did not load its values has no name and changes nothing\n    AND new.display_name <> ''\n),\nemptied AS (\n  DELETE FROM metric_notes\n  WHERE metric_id IN (SELECT metric_id FROM new WHERE note = '')\n)\nINSERT INTO metric_notes (metric_id, note)\nSELECT metric_id, note FROM new WHERE note <> ''\nON CONFLICT (metric_id) DO UPDATE SET note = EXCLUDED.note, updated = now()"
          },
          "code": "if (context.panel.response) {\n  context.grafana.notifySuccess(['Metric', 'Saved.']);\n  context.grafana.refresh();\n} else {\n  context.grafana.notifyError(['Metric', 'Not saved.']);\n}",
          "confirm": false,
          "contentType": "application/json"
