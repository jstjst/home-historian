# =====================================================================
# home-historian - example configuration
#   cp .env.example .env   and set the passwords. .env is git-ignored.
# =====================================================================

# --- What runs --------------------------------------------------------
# db          TimescaleDB + Grafana
# open3e      module: Viessmann E3 devices over CAN
# open3e-sim  simulator for it (virtual CAN bus, no hardware needed)
# vicare      module: Viessmann ViCare cloud API
# mbus        module: wired M-Bus meters over a serial port
# mbus-sim    simulator for it (meters behind a TCP port, no hardware needed)
# senec       module: SENEC.Home battery storage over its local API
# tools       MQTT explorer + pgAdmin
COMPOSE_PROFILES=db,open3e,open3e-sim,tools

# The address broker, database and web UIs listen on.
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the LAN as well
# (broker and tools have NO login - trusted networks only).
BIND_ADDRESS=127.0.0.1

TZ=Europe/Berlin

# --- Database ---------------------------------------------------------
POSTGRES_DB=historian
POSTGRES_USER=historian
POSTGRES_PASSWORD=change-me
# Read-only role Grafana queries with.
GRAFANA_DB_PASSWORD=change-me

# Database on another host: remove the "db" profile above and set this.
#INGEST_DATABASE_URL=postgresql://historian:password@db-host:5432/historian?connect_timeout=10

# --- Grafana (admin login, only applies on the very first start) ------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# --- MQTT -------------------------------------------------------------
# Top-level topic segment of all modules.
MQTT_TOPIC_PREFIX=historian
# Only needed if authentication is set up in mosquitto.conf.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Module open3e ----------------------------------------------------
# vcan0 = simulator, can0 = a real CAN adapter (bring it up first:
# modules/open3e/README.md, "Commissioning").
OPEN3E_CAN_INTERFACE=vcan0
# Data points to read: <device>.<DID> or <device>.[<DID>,<DID>,...], device
# names from modules/open3e/config/devices.json. Or "all": every data point
# of a scanned system (modules/open3e/README.md, "Reading every data point").
OPEN3E_DIDS=vitocal.268,vitocal.396,vitocharge.1603
#OPEN3E_DIDS=all
# Pause between two passes.
OPEN3E_INTERVAL_SECONDS=60

# --- Module vicare ----------------------------------------------------
# Client ID from the developer portal: https://app.developer.viessmann.com/
VICARE_CLIENT_ID=
# Credentials of the ViCare app.
VICARE_EMAIL=
VICARE_PASSWORD=
# heating = heat pump, electricityStorage = battery storage.
VICARE_DEVICE_TYPE=heating
# 300 s = 288 requests a day; the API quota is tight (minimum 60).
VICARE_POLL_INTERVAL_SECONDS=300

# --- Module mbus ------------------------------------------------------
# Serial device of the host the M-Bus master (level converter) is connected to.
MBUS_SERIAL_DEVICE=/dev/ttyUSB0
# Simulator instead of hardware: no device to pass in, and a TCP port.
#MBUS_SERIAL_DEVICE=/dev/null
#MBUS_SERIAL_PORT=socket://mbus-sim:2400
MBUS_BAUDRATE=2400
# Meters to read: <name>:<primary address>,... Every name needs a row in
# "devices" with the device_key mbus/<name> (see modules/mbus/README.md).
MBUS_METERS=
# Minimum 120: battery-powered meters pay for every reading.
MBUS_POLL_INTERVAL_SECONDS=120

# --- Module senec -----------------------------------------------------
# Scheme and address of the SENEC.Home, e.g. https://192.168.1.50
SENEC_URL=
# Sections to read. all = every section the unit has: close to a thousand
# values per pass, serial numbers included (modules/senec/README.md).
SENEC_SECTIONS=all
#SENEC_SECTIONS=ENERGY,PM1OBJ1,PV1,BMS,TEMPMEASURE
# Minimum 5.
SENEC_POLL_INTERVAL_SECONDS=60
